    {
      "id": "NET-BANDWIDTH",
      "status": "implemented",
      "profile_id": "lecture-network",
      "expression": "traffic_bytes*8/transfer_seconds",
      "output_unit": "bps",
      "inputs": [
        "traffic_bytes",
        "transfer_seconds"
      ],
      "source_id": "lecture-07",
      "source_pages": [
        3
      ],
      "notes": "Normalized from lecture definitions; workload/overhead scope must be supplied."
    },
    {
      "id": "NET-DOWNLINK-PORTS",
      "status": "implemented",
      "profile_id": "lecture-network",
      "expression": "required_ports*expansion_factor*stability_factor",
      "output_unit": "ports-before-rounding",
      "inputs": [
        "required_ports",
        "expansion_factor",
        "stability_factor"
      ],
      "source_id": "lecture-07",
      "source_pages": [
        5,
        6
      ],
      "notes": "Ceiling and purchasable configurations are a separate proposed product policy."
    },
    {
      "id": "NET-UPLINK",
      "status": "implemented",
      "profile_id": "lecture-network",
      "expression": "downlink_gbps*downlink_ports*role_factor",
